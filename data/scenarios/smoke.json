{
  "description": "Smoke test del modo FPS (level-1): carga, simula 2 s sin errores y existen las entidades básicas.",
  "scenes": ["level-1.json"],
  "seed": 1,
  "steps": [
    {
      "assert": {
        "status": true,
        "path": "gamestate",
        "value": "gs_gameplay"
      }
    },
    {
      "assert": {
        "status": true,
        "path": "entityCount",
        "op": ">",
        "value": 0
      }
    },
    {
      "assert": {
        "entity": "MainCamera",
        "path": "camera",
        "op": "exists"
      }
    },
    {
      "assert": {
        "entity": "DummyEnemy",
        "path": "health.currentHp",
        "op": ">",
        "value": 0
      }
    },
    {
      "wait_seconds": 2
    },
    {
      "assert": {
        "entity": "Player",
        "path": "position",
        "op": "exists"
      }
    },
    {
      "screenshot": "after-2s"
    },
    {
      "assert": {
        "no_errors": true
      }
    }
  ]
}
