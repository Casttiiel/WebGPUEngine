{
  "description": "Fase 6: en exploración el resto de la party sigue al seleccionado. Al moverlo, los demás van a una formación detrás de su destino (o sobre su camino si el hueco no se puede pisar), sin solaparse. Los caídos no se mueven; con follow: false o en combate se mueve solo el seleccionado.",
  "scenes": ["tactical.json"],
  "seed": 1,
  "steps": [
    {
      "wait_until": { "status": true, "path": "navMeshBuilt", "value": true },
      "timeout_frames": 300
    },
    { "wait_frames": 5 },
    {
      "eval": "window.__feet = (n) => Array.from(Engine.getEntities().getEntityByName(n).getComponent('unit').getFeetPosition(new Float32Array(3))); window.__dist = (a, b) => { const p = __feet(a); const q = __feet(b); return Math.hypot(p[0] - q[0], p[2] - q[2]); }; window.__heroes = ['Hero1', 'Hero2', 'Hero3', 'Hero4']"
    },

    { "log": "Mover al seleccionado: los demás le siguen" },
    { "command": "move", "args": { "unit": "Hero1", "to": [-10, 0, 2] } },
    { "wait_frames": 2 },
    {
      "assert": {
        "expr": "__heroes.map(n => Engine.getEntities().getEntityByName(n).getComponent('unit').isMoving())",
        "value": [true, true, true, true]
      }
    },
    {
      "wait_until": {
        "expr": "__heroes.every(n => !Engine.getEntities().getEntityByName(n).getComponent('unit').isMoving())",
        "value": true
      },
      "timeout_frames": 900
    },
    {
      "assert": {
        "expr": "['Hero2', 'Hero3', 'Hero4'].every(n => __dist(n, 'Hero1') < 3.5)",
        "value": true,
        "message": "todos cerca del líder"
      }
    },
    {
      "assert": {
        "expr": "(() => { for (let i = 0; i < 4; i++) for (let j = i + 1; j < 4; j++) if (__dist(__heroes[i], __heroes[j]) < 0.8) return false; return true; })()",
        "value": true,
        "message": "sin solaparse"
      }
    },
    {
      "assert": {
        "expr": "['Hero2', 'Hero3', 'Hero4'].every(n => __feet(n)[2] < __feet('Hero1')[2])",
        "value": true,
        "message": "detrás del líder (venía de -Z)"
      }
    },
    { "screenshot": "01-formation" },

    { "log": "Otro líder: siguen al nuevo seleccionado" },
    { "command": "select", "args": { "unit": "Hero3" } },
    { "command": "move", "args": { "unit": "Hero3", "to": [4, 0, -4] } },
    {
      "wait_until": {
        "expr": "__heroes.every(n => !Engine.getEntities().getEntityByName(n).getComponent('unit').isMoving())",
        "value": true
      },
      "timeout_frames": 900
    },
    {
      "assert": {
        "expr": "['Hero1', 'Hero2', 'Hero4'].every(n => __dist(n, 'Hero3') < 3.5)",
        "value": true
      }
    },

    { "log": "follow: false mueve solo al seleccionado" },
    { "eval": "window.__before = ['Hero1', 'Hero2', 'Hero4'].map(__feet)" },
    {
      "assert": {
        "expr": "__engine.gameCommand('move', { unit: 'Hero3', to: [6, 0, -1], follow: false }).then(r => r.ok)",
        "value": true
      }
    },
    { "wait_frames": 5 },
    { "assert": { "entity": "Hero3", "path": "unit.isMoving", "value": true } },
    {
      "assert": {
        "expr": "['Hero1', 'Hero2', 'Hero4'].some(n => Engine.getEntities().getEntityByName(n).getComponent('unit').isMoving())",
        "value": false
      }
    },
    {
      "wait_until": { "entity": "Hero3", "path": "unit.isMoving", "value": false },
      "timeout_frames": 300
    },

    { "log": "Un caído no sigue" },
    { "command": "damage", "args": { "unit": "Hero4", "amount": 100 } },
    { "eval": "window.__down = __feet('Hero4')" },
    { "command": "move", "args": { "unit": "Hero3", "to": [-4, 0, -6] } },
    {
      "wait_until": {
        "expr": "__heroes.every(n => !Engine.getEntities().getEntityByName(n).getComponent('unit').isMoving())",
        "value": true
      },
      "timeout_frames": 900
    },
    {
      "assert": {
        "expr": "Math.hypot(__feet('Hero4')[0] - __down[0], __feet('Hero4')[2] - __down[2]) < 0.05",
        "value": true
      }
    },
    {
      "assert": {
        "expr": "['Hero1', 'Hero2'].every(n => __dist(n, 'Hero3') < 3.5)",
        "value": true
      }
    },
    { "assert": { "no_errors": true } }
  ]
}
