{
  "description": "Fase 6: como el ataque cuerpo a cuerpo, todo lo que tiene alcance se acerca solo si hace falta (y si cabe en el movimiento): ataques a distancia, saltar (anda hasta un punto de despegue; andar + saltar cuesta los metros de ambos), empujar objetos y habilidades sobre una unidad o un punto. Al llegar se hace la acción; sin metros suficientes no se puede.",
  "scenes": ["tactical.json", "tactical_props.json", "tactical_dummies.json"],
  "seed": 1,
  "steps": [
    {
      "wait_until": { "status": true, "path": "navMeshBuilt", "value": true },
      "timeout_frames": 300
    },
    { "wait_frames": 5 },
    {
      "eval": "window.__feet = (n) => Array.from(Engine.getEntities().getEntityByName(n).getComponent('unit').getFeetPosition(new Float32Array(3))); window.__dist2 = (p, q) => Math.hypot(p[0] - q[0], p[2] - q[2])"
    },

    { "log": "Empujar un objeto lejano: anda hasta él y lo empuja" },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_push', { unit: 'Hero1', target: 'Crate' }).then(r => [r.canPush, r.inReach, r.approach > 0])",
        "value": [true, false, true]
      }
    },
    { "eval": "window.__crate = __feet('Crate')" },
    {
      "assert": {
        "expr": "__engine.gameCommand('push', { unit: 'Hero1', target: 'Crate' }).then(r => r.ok)",
        "value": true
      }
    },
    { "wait_frames": 2 },
    { "assert": { "entity": "Hero1", "path": "unit.isMoving", "value": true } },
    {
      "wait_until": {
        "expr": "!__engine.getCombatState().busy && !Engine.getEntities().getEntityByName('Crate').getComponent('unit').isMoving() && __dist2(__feet('Crate'), window.__crate) > 1",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "assert": {
        "expr": "__dist2(__feet('Crate'), window.__crate) > 2.5",
        "value": true,
        "message": "la caja se ha desplazado"
      }
    },

    { "log": "Habilidad sobre un punto fuera de alcance: se acercaría" },
    { "command": "select", "args": { "unit": "Hero2" } },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero2', skill: 'fireball', to: [6, 0, 5.5] }).then(r => [r.canCast, r.inRange, r.approach > 0])",
        "value": [true, false, true]
      }
    },

    { "log": "En combate: saltar lejos (anda hasta el despegue y salta), los metros de ambos" },
    { "command": "select", "args": { "unit": "Hero1" } },
    { "command": "move", "args": { "unit": "Hero1", "to": [2, 0, 0.5], "follow": false } },
    { "wait_until": { "combat": true, "path": "state", "value": "combat" }, "timeout_frames": 600 },
    {
      "wait_until": {
        "expr": "(() => { const s = __engine.getCombatState(); if (s.activeUnit === 'Hero1' && !s.busy) return true; if (s.playerTurn && !s.busy) __engine.gameCommand('end_turn', {}); return false; })()",
        "value": true
      },
      "timeout_frames": 1500,
      "check_every": 5
    },
    {
      "wait_until": { "entity": "Hero1", "path": "unit.isBusy", "value": false },
      "timeout_frames": 300
    },
    { "assert": { "combat": true, "path": "resources.movement", "value": 9 } },
    {
      "eval": "window.__jump = null; __engine.gameCommand('plan_jump', { unit: 'Hero1', to: [-3, 0, 4] }).then(r => window.__jump = r)"
    },
    { "wait_frames": 1 },
    {
      "assert": {
        "expr": "[window.__jump.canJump, window.__jump.approach > 0, window.__jump.approach + window.__jump.distance <= 9]",
        "value": [true, true, true]
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('jump', { unit: 'Hero1', to: [-3, 0, 4] }).then(r => r.ok)",
        "value": true
      }
    },
    {
      "wait_until": {
        "expr": "!__engine.getCombatState().busy && !Engine.getEntities().getEntityByName('Hero1').getComponent('unit').isBusy()",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "assert": {
        "expr": "__dist2(__feet('Hero1'), [-3, 0, 4]) < 0.4",
        "value": true,
        "message": "ha aterrizado en el destino"
      }
    },
    {
      "assert": {
        "expr": "Math.abs(__engine.getCombatState().resources.movement - (9 - window.__jump.approach - window.__jump.distance)) < 0.6",
        "value": true,
        "message": "ha gastado andar + saltar"
      }
    },

    { "log": "Sin metros para acercarse: no se puede" },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero1', skill: 'shove', target: 'Enemy2' }).then(r => [r.canCast, r.reason])",
        "value": [false, "target out of range"]
      }
    },
    { "assert": { "no_errors": true } }
  ]
}
