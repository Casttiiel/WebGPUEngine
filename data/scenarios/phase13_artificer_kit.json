{
  "description": "Fase 13, Artificiera (2): Resonancia de ettmetal (pasiva: los aliados a 3 m cuentan con +2 POT; a ella y a los enemigos, no), Vial de metal (aliado con Reserva: 2 + TEM/2), Pilón de acero (prop metálico alto que da cobertura; uno a la vez; el Pulso lo lanza) y Mente de cobre (sin acción, 1 carga: la siguiente habilidad del turno se repite gratis, sin acción, metal ni recarga).",
  "scenes": ["tactical.json", "tactical_props.json", "tactical_dummies.json"],
  "seed": 13,
  "steps": [
    {
      "wait_until": {
        "status": true,
        "path": "navMeshBuilt",
        "value": true
      },
      "timeout_frames": 300
    },
    {
      "wait_frames": 5
    },
    {
      "eval": "window.__unit = (n) => Engine.getEntities().getEntityByName(n).getComponent('unit'); window.__enc = Engine.getEntities().getObjectManagerByName('encounter').getList()[0]; window.__log = []; __enc.onEvent((e, d) => __log.push([e, d.unit ? d.unit.getName() : null, d.amount ?? null, d.status ?? null])); window.__tp = (n, x, z) => __unit(n).setFeetPosition([x, 0, z]); window.__S = 'Artificiera'; window.__idle = () => !__engine.getCombatState().busy && Engine.getEntities().getObjectManagerByName('unit').getList().every(u => !u.isBusy()); window.__turns = (n, from = 0) => __log.slice(from).filter(l => l[0] === 'turn' && l[1] === n).length; window.__marks = {}; window.__mark = (n) => { __marks[n] = __turns(n); }; window.__turnOf = (n) => { const s = __engine.getCombatState(); if (__turns(n) > (__marks[n] ?? -1) && s.activeUnit === n && !s.busy) return true; if (s.playerTurn && !s.busy) __engine.gameCommand('end_turn', {}); return false; }; window.__bubbles = (time) => __engine.getCombatState().bubbles.filter(b => b.time === time); window.__x = (n) => Math.round(__unit(n).getFeetPosition()[0] * 10) / 10; window.__ui = (a) => Engine.getModules().getModule('ui').getWidgetByAlias(a); window.__hotbar = () => Array.from({ length: 12 }, (_, i) => __ui('hotbar_' + (i + 1) + '_name')).filter(Boolean).map(w => w.getText()); window.__pylon = () => Engine.getEntities().getEntityByName('Artificiera_Pylon'); window.__pylonAt = () => { const e = __pylon(); if (!e) return null; const p = e.getComponent('unit').getFeetPosition(); return [Math.round(p[0] * 10) / 10, Math.round(p[2] * 10) / 10]; }"
    },
    {
      "eval": "for (const u of Engine.getEntities().getObjectManagerByName('unit').getList()) { u.sightRange = 0; } __enc.joinRadius = 60; __tp(__S, -10, -12); __tp('Deslizador', -9.2, -12); __tp('Voz', -4, -7); __tp('Lanzamonedas', -6, -8); __tp('Enemy1', -4.5, -16); __tp('Enemy2', -15, -4); __tp('Enemy3', -15, -17)"
    },
    {
      "wait_frames": 3
    },
    {
      "log": "Resonancia de ettmetal: el Lanzamonedas lejos tiene POT 6; pegado a ella, 8 (y empuja más lejos). A ella misma no le sube"
    },
    {
      "assert": {
        "expr": "[__unit('Lanzamonedas').getAttribute('POT'), __unit(__S).getAttribute('POT')]",
        "value": [6, 4]
      }
    },
    {
      "eval": "__tp('Lanzamonedas', -10, -10.4)"
    },
    {
      "wait_frames": 3
    },
    {
      "assert": {
        "expr": "[__unit('Lanzamonedas').getAttribute('POT'), __unit('Lanzamonedas').getBaseAttributes().POT, __unit('Lanzamonedas').resonanceBonus().source.getOwner().getName()]",
        "value": [8, 6, "Artificiera"]
      }
    },
    {
      "log": "A un enemigo pegado a ella no le afecta"
    },
    {
      "eval": "window.__ePot = __unit('Enemy1').getAttribute('POT'); __tp('Enemy1', -11.4, -12)"
    },
    {
      "wait_frames": 3
    },
    {
      "assert": {
        "expr": "__unit('Enemy1').getAttribute('POT') === __ePot",
        "value": true
      }
    },
    {
      "eval": "__tp('Enemy1', -4.5, -16)"
    },
    {
      "wait_frames": 3
    },
    {
      "eval": "__mark(__S)"
    },
    {
      "command": "start_combat"
    },
    {
      "wait_until": {
        "expr": "__turnOf(__S)",
        "value": true
      },
      "timeout_frames": 3000
    },
    {
      "eval": "__enc.resources = { action: 9, bonusAction: 9, movement: 99 }; __unit(__S).maxMetal = 20; __unit(__S).setMetal(20); __tp('Lanzamonedas', -10, -10.4); __tp('Deslizador', -9.2, -12); __tp('Voz', -4, -7)"
    },
    {
      "wait_frames": 3
    },
    {
      "log": "El aro de la Resonancia aparece en combate"
    },
    {
      "assert": {
        "expr": "Engine.getEntities().getEntityByName('ResonanceAura') !== null",
        "value": true
      }
    },
    {
      "screenshot": "01-resonance"
    },
    {
      "log": "Vial de metal: a la Voz (Reserva 2 de 12) le devuelve 2 + TEM 5/2 = 4"
    },
    {
      "eval": "__unit('Voz').setMetal(2)"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'metal_vial', target: __S }).then(r => [r.canCast, r.reason])",
        "value": [false, "target must be an ally"]
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'metal_vial', target: 'Deslizador' }).then(r => [r.canCast, r.reason])",
        "value": [false, "reserve full"]
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'metal_vial', target: 'Enemy1' }).then(r => [r.canCast, r.reason])",
        "value": [false, "target must be an ally"]
      }
    },
    {
      "eval": "window.__from = __log.length"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: __S, skill: 'metal_vial', target: 'Voz' }).then(r => [r.ok, r.metalCost])",
        "value": [true, 1]
      }
    },
    {
      "wait_until": {
        "expr": "__idle()",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "assert": {
        "expr": "[__unit('Voz').getMetal(), __log.slice(__from).filter(l => l[0] === 'metal-gain').map(l => [l[1], l[2]])]",
        "value": [6, [["Voz", 4]]]
      }
    },
    {
      "log": "Mente de cobre: decantar (sin acción) y luego el Pilón de acero"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: __S, skill: 'copper_mind' }).then(r => [r.ok, r.metalCost])",
        "value": [true, 0]
      }
    },
    {
      "wait_until": {
        "expr": "__idle()",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "assert": {
        "expr": "[__unit(__S).hasStatus('copper'), __unit(__S).getCharges('copper'), __unit(__S).getEchoSkill()]",
        "value": [true, 0, null]
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'steel_pylon', to: [-10, 0, -12] }).then(r => [r.canCast, r.reason])",
        "value": [false, "cannot place there"],
        "message": "encima de ella, no"
      }
    },
    {
      "eval": "window.__bonus = __enc.resources.bonusAction"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: __S, skill: 'steel_pylon', to: [-13, 0, -13] }).then(r => [r.ok, r.metalCost])",
        "value": [true, 1]
      }
    },
    {
      "wait_until": {
        "expr": "__idle()",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "wait_until": {
        "expr": "__pylon() !== null",
        "value": true
      },
      "timeout_frames": 300
    },
    {
      "wait_frames": 3
    },
    {
      "assert": {
        "expr": "[__pylonAt(), __enc.resources.bonusAction === __bonus - 1, __unit(__S).getEchoSkill()]",
        "value": [[-13, -13], true, "steel_pylon"]
      }
    },
    {
      "log": "El pilón es un prop metálico alto: da cobertura"
    },
    {
      "assert": {
        "expr": "(() => { const u = __pylon().getComponent('unit'); const p = __pylon().getComponent('tactical_prop'); return [p.isMetallic(), p.isSmall(), u.getFeetOffset() * 2 >= 1.2]; })()",
        "value": [true, false, true]
      }
    },
    {
      "assert": {
        "expr": "__hotbar().includes('Pilón de acero ×2')",
        "value": true
      }
    },
    {
      "screenshot": "02-pylon"
    },
    {
      "log": "La repetición: con la recarga puesta, sin acción adicional ni metal; el pilón nuevo sustituye al anterior"
    },
    {
      "eval": "window.__metal = __unit(__S).getMetal(); window.__bonus = __enc.resources.bonusAction; window.__from = __log.length"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'steel_pylon', to: [-12, 0, -9] }).then(r => [r.canCast, r.metalCost])",
        "value": [true, 0]
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: __S, skill: 'steel_pylon', to: [-12, 0, -9] }).then(r => r.ok)",
        "value": true
      }
    },
    {
      "wait_until": {
        "expr": "__idle()",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "wait_until": {
        "expr": "JSON.stringify(__pylonAt()) === '[-12,-9]'",
        "value": true
      },
      "timeout_frames": 300
    },
    {
      "wait_frames": 3
    },
    {
      "assert": {
        "expr": "[Engine.getEntities().getObjectManagerByName('unit').getList().filter(u => u.getOwner().getName() === 'Artificiera_Pylon').length, __unit(__S).getMetal() === __metal, __enc.resources.bonusAction === __bonus, __unit(__S).hasStatus('copper'), __log.slice(__from).some(l => l[0] === 'echo')]",
        "value": [1, true, true, false, true]
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'steel_pylon', to: [-13, 0, -13] }).then(r => [r.canCast, r.reason])",
        "value": [false, "on cooldown"],
        "message": "ya no hay repetición"
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'copper_mind' }).then(r => [r.canCast, r.reason])",
        "value": [false, "no charges"],
        "message": "una carga por combate"
      }
    },
    {
      "log": "Pulso de ettmetal junto al pilón: sale despedido (es metal)"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: __S, skill: 'ettmetal_pulse', to: [-12, 0, -11] }).then(r => r.motions.map(m => m.body))",
        "value": ["Artificiera_Pylon"]
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: __S, skill: 'ettmetal_pulse', to: [-12, 0, -11] }).then(r => r.ok)",
        "value": true
      }
    },
    {
      "wait_until": {
        "expr": "__idle()",
        "value": true
      },
      "timeout_frames": 600
    },
    {
      "assert": {
        "expr": "__pylonAt()[1] > -8",
        "value": true,
        "message": "hacia fuera, alejándose del centro"
      }
    },
    {
      "screenshot": "03-pulse-pylon"
    },
    {
      "log": "Al acabar el combate desaparecen el pilón y el aro"
    },
    {
      "command": "end_combat"
    },
    {
      "wait_frames": 3
    },
    {
      "assert": {
        "expr": "[__pylon(), Engine.getEntities().getEntityByName('ResonanceAura')]",
        "value": [null, null]
      }
    },
    {
      "assert": {
        "no_errors": true
      }
    }
  ]
}
