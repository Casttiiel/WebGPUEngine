# Large Tileable Plane
# Size: 100x100 units
# UVs: Tiled 10x10 (texture repeats 10 times in each direction)
# Normals: Pointing up (Y+)

# Vertices (XZ plane, Y=0)
v -50.0 0.0 -50.0
v  50.0 0.0 -50.0
v  50.0 0.0  50.0
v -50.0 0.0  50.0

# Texture coordinates (tiled 10x10)
vt 0.0 0.0
vt 10.0 0.0
vt 10.0 10.0
vt 0.0 10.0

# Normals (pointing up: Y+)
vn 0.0 1.0 0.0

# Faces (v/vt/vn format)
# Two triangles forming a quad (counter-clockwise winding for Y+ normals)
f 1/1/1 3/3/1 2/2/1
f 1/1/1 4/4/1 3/3/1
