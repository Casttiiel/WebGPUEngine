    "head_bob": {
      "frequency": 1.0,
      "verticalAmplitude": 0.05,
      "horizontalAmplitude": 0.05,
      "speedThreshold": 0.5,
      "enabled": true
    },
    "camera_fov_modifier": {
      "maxFOVIncrease": 10.0,
      "speedThreshold": 1.0,
      "lerpSpeed": 5.0,
      "enabled": true
