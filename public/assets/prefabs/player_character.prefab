{
  "components": {
    "name": "Player Character",
    "transform": {
      "position": [0, 2.9, 0],
      "scale": [0.6,
          1.8,
          0.6]
    },
    "render": {
      "meshes": [
        {
            "mesh": "unit_cube.obj",
            "material": "textured.mat"
          }
      ]
    },
    "capsule_collider": {
      "height": 1.8,
      "radius": 0.3,
