{
  "components": {
    "name": "Enemy",
    "transform": {
      "position": [0, 0.9, 0],
      "rotation": [0, 180, 0],
      "scale": [0.6, 1.8, 0.6]
    },
    "capsule_collider": {
      "height": 1.8,
      "radius": 0.3,
      "bodyType": "kinematic",
      "lockRotationX": true,
      "lockRotationZ": true,
      "ignoreTransformScale": true,
