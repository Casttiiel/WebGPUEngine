{
  "description": "Fase 5 (punto 18): habilidades definidas en data/skills.json. Bola de fuego (punto + área circular), Onda atronadora (cono, daño + empujón), Palabra curativa (unidad aliada, levanta a un caído), Segundo aliento (self), Empellón (unidad enemiga, empujón) y Embestida (punto, teletransporte en línea recta). Vista previa del área y de los afectados, coste en acción / acción adicional y cooldowns por turno.",
  "scenes": ["tactical.json", "tactical_dummies.json"],
  "seed": 4,
  "steps": [
    {
      "wait_until": { "status": true, "path": "navMeshBuilt", "value": true },
      "timeout_frames": 300
    },
    { "wait_frames": 5 },
    {
      "eval": "window.__log = []; Engine.getEntities().getObjectManagerByName('encounter').getList()[0].onEvent((e, d) => window.__log.push({ e, u: d.unit ? d.unit.getName() : null, cause: d.cause ?? null, amount: d.amount ?? null }))"
    },
    {
      "eval": "window.__until = (hero) => { const s = __engine.getCombatState(); if (s.activeUnit === hero && !s.busy) return true; if (s.playerTurn && !s.busy) __engine.gameCommand('end_turn', {}); return false; }"
    },

    {
      "log": "Embestida (exploración, Hero4): en línea recta hasta el punto; no atraviesa paredes"
    },
    { "command": "select", "args": { "unit": "Hero4" } },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero4', skill: 'dash', to: [-3.5, 0, -15] }).then(r => r.reason)",
        "value": "target out of range"
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: 'Hero4', skill: 'dash', to: [-0.5, 0, -10.5] }).then(r => r.ok)",
        "value": true
      }
    },
    { "wait_frames": 30 },
    {
      "assert": {
        "entity": "Hero4",
        "path": "position",
        "op": "approx",
        "value": [-0.5, 0.9, -10.5],
        "tolerance": 0.1
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero4', skill: 'dash', to: [-3.5, 0, -13.2] }).then(r => r.reason)",
        "value": "path blocked",
        "message": "la columna 4 está en medio"
      }
    },

    {
      "log": "Bola de fuego (Hero2): armarla en la hotbar, vista previa del área y de los afectados"
    },
    { "command": "select", "args": { "unit": "Hero2" } },
    { "command": "move", "args": { "unit": "Hero2", "to": [-3, 0, 4.5] } },
    {
      "wait_until": { "entity": "Hero2", "path": "unit.isMoving", "value": false },
      "timeout_frames": 600
    },
    { "assert": { "combat": true, "path": "state", "value": "exploration" } },
    {
      "eval": "Engine.getEntities().getObjectManagerByName('tactical_camera_controller').getList()[0].focusOn([2, 0, 5], false)"
    },
    { "wait_frames": 60 },
    { "input": { "type": "click", "widget": "hotbar_5" } },
    { "wait_frames": 2 },
    {
      "assert": {
        "entity": "Party",
        "path": "tactical_pointer.getArmedAttack",
        "value": "fireball"
      }
    },
    { "input": { "type": "move", "world": [5, 0, 6] } },
    { "wait_frames": 3 },
    { "assert": { "entity": "Party", "path": "tactical_pointer.getCursor", "value": "attack" } },
    {
      "assert": {
        "expr": "Engine.getEntities().getObjectManagerByName('tactical_pointer').getList()[0].getSkillPlan().affected.map(u => u.getOwner().getName())",
        "value": ["Enemy1"],
        "message": "los afectados se ven antes de confirmar"
      }
    },
    {
      "assert": {
        "expr": "Engine.getEntities().getAllEntities().filter(e => e.getName() === 'PathDot' && e.getComponent('render').isVisible()).length",
        "op": ">",
        "value": 10,
        "message": "contorno del área"
      }
    },
    { "assert": { "expr": "__engine.getWidgetRect('cursor_label').visible", "value": true } },
    { "screenshot": "01-fireball-preview" },
    { "input": { "type": "click", "world": [5, 0, 6] } },
    { "wait_frames": 45 },
    {
      "assert": {
        "expr": "window.__log.filter(x => x.u === 'Enemy1' && x.e === 'damage').map(x => [x.cause, x.amount])",
        "value": [
          ["skill", 10],
          ["fire", 5]
        ],
        "message": "10 de la explosión y 5 del fuego que deja bajo sus pies"
      }
    },
    {
      "assert": {
        "combat": true,
        "path": "state",
        "value": "combat",
        "message": "atacar con una habilidad empieza el combate"
      }
    },
    {
      "assert": {
        "expr": "__engine.getCombatState().surfaces.map(s => s.type)",
        "value": ["fire"],
        "message": "deja fuego"
      }
    },
    { "assert": { "entity": "Party", "path": "tactical_pointer.getArmedAttack", "value": null } },
    { "screenshot": "02-fireball" },

    {
      "log": "Onda atronadora (Hero2, cono): daño y empujón; gasta la acción; cooldown de 2 turnos"
    },
    {
      "wait_until": { "expr": "window.__until('Hero2')", "value": true },
      "timeout_frames": 1500,
      "check_every": 5
    },
    { "command": "move", "args": { "unit": "Hero2", "to": [5.6, 0, 4.4] } },
    {
      "wait_until": { "entity": "Hero2", "path": "unit.isMoving", "value": false },
      "timeout_frames": 400
    },
    { "eval": "window.__e2 = __engine.readPath('Enemy2', 'position')" },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero2', skill: 'thunderwave', to: [7.5, 0, 4] }).then(r => r.affected.includes('Enemy2') && r.canCast)",
        "value": true
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: 'Hero2', skill: 'thunderwave', to: [7.5, 0, 4] }).then(r => r.ok)",
        "value": true
      }
    },
    { "wait_frames": 60 },
    { "assert": { "entity": "Enemy2", "path": "health.getHp", "value": 14 } },
    {
      "assert": {
        "expr": "(() => { const p = __engine.readPath('Enemy2', 'position'); return Math.hypot(p[0] - window.__e2[0], p[2] - window.__e2[2]); })()",
        "op": ">",
        "value": 1,
        "message": "empujado lejos de Hero2"
      }
    },
    { "assert": { "combat": true, "path": "resources.action", "value": 0 } },
    {
      "assert": {
        "expr": "__engine.getCombatState().units.find(u => u.name === 'Hero2').cooldowns",
        "value": { "thunderwave": 2 }
      }
    },
    { "screenshot": "03-thunderwave" },
    { "command": "end_turn" },
    {
      "wait_until": { "expr": "window.__until('Hero2')", "value": true },
      "timeout_frames": 1500,
      "check_every": 5
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero2', skill: 'thunderwave', to: [7.5, 0, 4] }).then(r => r.reason)",
        "value": "on cooldown",
        "message": "un turno después sigue recargando"
      }
    },
    { "wait_frames": 2 },
    {
      "assert": {
        "expr": "__engine.getWidgetRect('hotbar_6').visible",
        "value": true
      }
    },
    { "command": "end_turn" },
    {
      "wait_until": { "expr": "window.__until('Hero2')", "value": true },
      "timeout_frames": 1500,
      "check_every": 5
    },
    {
      "assert": {
        "expr": "__engine.getCombatState().units.find(u => u.name === 'Hero2').cooldowns",
        "value": {},
        "message": "a los 2 turnos vuelve a estar disponible"
      }
    },

    { "log": "Palabra curativa (Hero3): cura a un aliado; gasta la acción adicional" },
    { "command": "damage", "args": { "unit": "Hero1", "amount": 15 } },
    {
      "wait_until": { "expr": "window.__until('Hero3')", "value": true },
      "timeout_frames": 1500,
      "check_every": 5
    },
    {
      "eval": "Engine.getEntities().getObjectManagerByName('tactical_camera_controller').getList()[0].focusOn(Engine.getEntities().getEntityByName('Hero1'), false)"
    },
    { "wait_frames": 60 },
    { "input": { "type": "key", "key": "Digit5" } },
    { "wait_frames": 2 },
    { "assert": { "entity": "Party", "path": "tactical_pointer.getArmedAttack", "value": "heal" } },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero3', skill: 'heal', target: 'Enemy2' }).then(r => r.reason)",
        "value": "target must be an ally"
      }
    },
    { "input": { "type": "move", "entity": "Hero1" } },
    { "wait_frames": 3 },
    { "assert": { "entity": "Party", "path": "tactical_pointer.getCursor", "value": "interact" } },
    { "input": { "type": "click", "entity": "Hero1" } },
    { "wait_frames": 45 },
    { "assert": { "entity": "Hero1", "path": "health.getHp", "value": 25 } },
    { "assert": { "combat": true, "path": "resources.bonusAction", "value": 0 } },
    { "assert": { "combat": true, "path": "resources.action", "value": 1 } },
    {
      "assert": {
        "entity": "Party",
        "path": "party.getSelectedName",
        "value": "Hero3",
        "message": "curar no selecciona al aliado"
      }
    },
    {
      "assert": {
        "expr": "window.__log.some(x => x.e === 'heal' && x.u === 'Hero1' && x.amount === 10)",
        "value": true
      }
    },

    { "log": "Segundo aliento (Hero1, self): se lanza al pulsarlo, sin elegir objetivo" },
    {
      "wait_until": { "expr": "window.__until('Hero1')", "value": true },
      "timeout_frames": 1500,
      "check_every": 5
    },
    { "input": { "type": "key", "key": "Digit6" } },
    { "wait_frames": 45 },
    {
      "assert": {
        "entity": "Hero1",
        "path": "health.getHp",
        "value": 30,
        "message": "25 + 8, hasta el máximo"
      }
    },
    { "assert": { "combat": true, "path": "resources.bonusAction", "value": 0 } },
    {
      "assert": {
        "expr": "__engine.getCombatState().units.find(u => u.name === 'Hero1').cooldowns",
        "value": { "second_wind": 3 }
      }
    },

    { "log": "Empellón (Hero4): empuja a un enemigo adyacente; acción adicional" },
    {
      "wait_until": { "expr": "window.__until('Hero4')", "value": true },
      "timeout_frames": 1500,
      "check_every": 5
    },
    {
      "eval": "window.__ep = __engine.readPath('Enemy2', 'position'); window.__dest = [window.__ep[0] - 1.1, 0, window.__ep[2]]"
    },
    {
      "eval": "__engine.gameCommand('move', { unit: 'Hero4', to: window.__dest })"
    },
    {
      "wait_until": { "entity": "Hero4", "path": "unit.isMoving", "value": false },
      "timeout_frames": 400
    },
    { "log": "Hero4 está lejos (la Embestida lo alejó): dos turnos de camino" },
    { "command": "end_turn" },
    {
      "wait_until": { "expr": "window.__until('Hero4')", "value": true },
      "timeout_frames": 1500,
      "check_every": 5
    },
    {
      "eval": "window.__ep = __engine.readPath('Enemy2', 'position'); window.__dest = [window.__ep[0] - 1.1, 0, window.__ep[2]]"
    },
    {
      "eval": "__engine.gameCommand('move', { unit: 'Hero4', to: window.__dest })"
    },
    {
      "wait_until": { "entity": "Hero4", "path": "unit.isMoving", "value": false },
      "timeout_frames": 400
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_skill', { unit: 'Hero4', skill: 'shove', target: 'Hero1' }).then(r => r.reason)",
        "value": "target must be an enemy"
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: 'Hero4', skill: 'shove', target: 'Enemy2' }).then(r => [r.ok, r.reason])",
        "value": [true, null]
      }
    },
    { "wait_frames": 60 },
    {
      "assert": {
        "expr": "(() => { const p = __engine.readPath('Enemy2', 'position'); return Math.hypot(p[0] - window.__ep[0], p[2] - window.__ep[2]); })()",
        "op": ">",
        "value": 1
      }
    },
    { "assert": { "combat": true, "path": "resources.bonusAction", "value": 0 } },
    { "assert": { "combat": true, "path": "resources.action", "value": 1 } },

    { "log": "Palabra curativa levanta a un aliado caído" },
    { "command": "damage", "args": { "unit": "Hero1", "amount": 100 } },
    { "assert": { "entity": "Hero1", "path": "unit.isAlive", "value": false } },
    {
      "wait_until": {
        "expr": "(() => { const s = __engine.getCombatState(); if (s.activeUnit === 'Hero3' && !s.busy && !s.units.find(u => u.name === 'Hero3').cooldowns.heal) return true; if (s.playerTurn && !s.busy) __engine.gameCommand('end_turn', {}); return false; })()",
        "value": true
      },
      "timeout_frames": 3000,
      "check_every": 5
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: 'Hero3', skill: 'heal', target: 'Hero1' }).then(r => [r.ok, r.reason])",
        "value": [true, null]
      }
    },
    { "wait_frames": 45 },
    { "assert": { "entity": "Hero1", "path": "unit.isAlive", "value": true } },
    { "assert": { "entity": "Hero1", "path": "health.getHp", "value": 10 } },

    { "log": "Fin del combate: los cooldowns se reinician" },
    { "command": "end_combat", "args": { "result": "victory" } },
    {
      "assert": {
        "expr": "__engine.getCombatState().units.every(u => Object.keys(u.cooldowns).length === 0)",
        "value": true
      }
    },
    { "assert": { "no_errors": true } }
  ]
}
