{
  "description": "Fase 3 (puntos 7-10): acercarse inicia el combate, iniciativa y rondas, recursos de turno, movimiento limitado con preview, unidades como obstáculos y enemigos que se unen tarde.",
  "scenes": ["tactical.json", "tactical_dummies.json"],
  "seed": 7,
  "entities": [
    {
      "prefab": "tactical/enemy.prefab",
      "components": {
        "name": "LateEnemy",
        "transform": { "position": [-15, 0, 14] },
        "unit": { "sightRange": 15 }
      }
    }
  ],
  "steps": [
    {
      "wait_until": { "status": true, "path": "navMeshBuilt", "value": true },
      "timeout_frames": 300
    },
    { "wait_frames": 5 },
    { "assert": { "combat": true, "path": "state", "value": "exploration" } },

    { "log": "Punto 10: las unidades son obstáculos (Hero1 seleccionado)" },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_move', { unit: 'Hero1', to: [-2.5, 0, -7.2] }).then(r => r.reachable)",
        "value": false,
        "message": "no se puede terminar dentro de otra unidad"
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_move', { unit: 'Hero1', to: [-1.33, 0, -8.14] }).then(r => r.reachable && r.points.length > 2 && r.length > 3.5)",
        "value": true,
        "message": "el camino rodea a Hero2 en vez de atravesarlo"
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('move', { unit: 'Hero2', to: [0, 0, -5] }).then(r => r.ok)",
        "value": false,
        "message": "en exploración solo se mueve el seleccionado"
      }
    },

    { "log": "Exploración: click en el suelo mueve al seleccionado (sin presupuesto de metros)" },
    { "input": { "type": "click", "world": [-8, 0, -4] } },
    { "wait_frames": 2 },
    { "assert": { "entity": "Hero1", "path": "unit.isMoving", "value": true } },
    {
      "wait_until": { "entity": "Hero1", "path": "unit.isMoving", "value": false },
      "timeout_frames": 300
    },
    {
      "assert": {
        "entity": "Hero1",
        "path": "position",
        "op": "approx",
        "value": [-8, 0.9, -4],
        "tolerance": 0.15
      }
    },
    {
      "assert": {
        "combat": true,
        "path": "state",
        "value": "exploration",
        "message": "nadie le ha visto aún"
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('start_combat', {}).then(r => r.started)",
        "value": false,
        "message": "sin enemigos cerca no hay combate"
      }
    },

    { "log": "Punto 7: acercarse a un enemigo inicia el combate (se interrumpe el movimiento)" },
    { "command": "move", "args": { "unit": "Hero1", "to": [1, 0, 0] } },
    { "wait_until": { "combat": true, "path": "state", "value": "combat" }, "timeout_frames": 400 },
    { "assert": { "entity": "Hero1", "path": "unit.isMoving", "value": false } },
    {
      "assert": {
        "expr": "__engine.getCombatState().turnOrder.map(c => c.name).filter(n => n.startsWith('Hero')).length",
        "value": 4
      }
    },
    {
      "assert": {
        "expr": "__engine.getCombatState().turnOrder.some(c => c.name === 'Enemy1')",
        "value": true
      }
    },
    {
      "assert": {
        "expr": "__engine.getCombatState().turnOrder.some(c => c.name === 'LateEnemy' || c.name === 'Enemy3')",
        "value": false,
        "message": "los lejanos no entran al principio"
      }
    },
    {
      "assert": {
        "expr": "(() => { const o = __engine.getCombatState().turnOrder; return o.every((c, i) => i === 0 || o[i - 1].initiative >= c.initiative); })()",
        "value": true,
        "message": "orden por iniciativa"
      }
    },
    {
      "assert": {
        "combat": true,
        "path": "resources",
        "value": { "action": 1, "bonusAction": 1, "movement": 9 }
      }
    },
    { "screenshot": "01-combat" },

    { "log": "Punto 8: pasar turnos hasta el de Hero1 (los enemigos pasan solos)" },
    {
      "wait_until": {
        "expr": "(() => { const s = __engine.getCombatState(); if (s.activeUnit === 'Hero1') return true; if (s.playerTurn) __engine.gameCommand('end_turn', {}); return false; })()",
        "value": true
      },
      "timeout_frames": 600,
      "check_every": 5
    },
    { "wait_frames": 60 },
    {
      "assert": {
        "entity": "Party",
        "path": "party.getSelectedName",
        "value": "Hero1",
        "message": "al empezar su turno se selecciona y la cámara lo sigue"
      }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('move', { unit: 'Hero2', to: [-3, 0, -5] }).then(r => r.reason)",
        "value": "not this unit’s turn"
      }
    },

    {
      "log": "Punto 9: fuera de alcance → camino con tramo rojo; el click avanzaría hasta donde llegue"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_move', { unit: 'Hero1', to: [7, 0, -6] }).then(r => r.reachable && !r.affordable && r.canMove && Math.abs(r.walkLength - 8) < 0.01)",
        "value": true,
        "message": "hay camino que excede los 8 m de Ham (6 + REF 4 / 2): se recorrerían exactamente 8"
      }
    },
    { "input": { "type": "move", "world": [7, 0, -6] } },
    { "wait_frames": 2 },
    {
      "assert": { "entity": "Party", "path": "tactical_pointer.getHoverKind", "value": "ground" }
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_move', { unit: 'Hero1', to: [7, 0, -6] }).then(r => { const far = Engine.getEntities().getAllEntities().filter(e => e.getName() === 'PathDot' && e.getComponent('render').isVisible() && e.getComponent('render').getParts()[0].material.path.includes('far')).length; return r.length - 9 > 0.6 ? far > 0 : true; })",
        "value": true,
        "message": "el tramo que excede el movimiento se pinta en rojo"
      }
    },
    {
      "assert": {
        "expr": "Engine.getEntities().getAllEntities().filter(e => e.getName() === 'PathDot' && e.getComponent('render').isVisible()).length",
        "op": ">",
        "value": 3
      }
    },
    { "screenshot": "02-preview-too-far" },

    { "log": "Punto 9: dentro de alcance → cursor de mover, puntos y metros junto al cursor" },
    {
      "eval": "window.__plan = null; __engine.gameCommand('plan_move', { unit: 'Hero1', to: [-4, 0, 5] }).then(r => (window.__plan = r))"
    },
    { "input": { "type": "move", "world": [-4, 0, 5] } },
    { "wait_frames": 2 },
    { "assert": { "entity": "Party", "path": "tactical_pointer.getHoverKind", "value": "ground" } },
    {
      "assert": {
        "expr": "__engine.getWidgetRect('cursor_label').visible",
        "value": true,
        "message": "etiqueta con los metros junto al cursor"
      }
    },
    { "screenshot": "03-preview" },

    { "log": "Movimiento real = preview: se descuentan exactamente los metros del camino" },
    { "input": { "type": "click", "world": [-4, 0, 5] } },
    { "wait_frames": 2 },
    {
      "assert": {
        "expr": "Math.abs(__engine.getCombatState().resources.movement - (8 - window.__plan.length)) < 0.35",
        "value": true
      }
    },
    {
      "wait_until": { "entity": "Hero1", "path": "unit.isMoving", "value": false },
      "timeout_frames": 300
    },
    {
      "assert": {
        "entity": "Hero1",
        "path": "position",
        "op": "approx",
        "value": [-4, 0.9, 5],
        "tolerance": 0.2
      }
    },

    {
      "log": "Punto 8: un enemigo que ve a la party a mitad de combate se une sin cambiar el turno actual"
    },
    { "wait_frames": 20 },
    {
      "assert": {
        "expr": "__engine.getCombatState().turnOrder.some(c => c.name === 'LateEnemy')",
        "value": true
      }
    },
    { "assert": { "combat": true, "path": "activeUnit", "value": "Hero1" } },
    { "screenshot": "04-late-join" },

    {
      "log": "Punto 9: click en un destino que no alcanza → avanza por el mismo camino hasta agotar los metros"
    },
    {
      "eval": "window.__far = null; __engine.gameCommand('plan_move', { unit: 'Hero1', to: [7, 0, -6] }).then(r => (window.__far = r))"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('move', { unit: 'Hero1', to: [7, 0, -6] }).then(r => r.ok && r.walked < r.length)",
        "value": true
      }
    },
    {
      "wait_until": { "entity": "Hero1", "path": "unit.isMoving", "value": false },
      "timeout_frames": 400
    },
    {
      "assert": {
        "combat": true,
        "path": "resources.movement",
        "op": "approx",
        "value": 0,
        "tolerance": 0.01
      }
    },
    {
      "assert": {
        "expr": "(() => { const p = __engine.readPath('Hero1', 'position'); const d = Math.hypot(p[0] - 7, p[2] + 6); return d > 0.5 && d <= window.__far.length - window.__far.walkLength + 0.2; })()",
        "value": true,
        "message": "se para en el camino, a la distancia que le faltaba del destino"
      }
    },
    { "screenshot": "05-partial-move" },

    { "log": "Fin de turno con Espacio" },
    { "input": { "type": "key", "key": "Space" } },
    { "wait_frames": 2 },
    { "assert": { "combat": true, "path": "activeUnit", "op": "!=", "value": "Hero1" } },

    { "log": "Rondas: el combate rota entre party y enemigos varias rondas" },
    {
      "wait_until": {
        "expr": "(() => { const s = __engine.getCombatState(); if (s.round >= 3) return true; if (s.playerTurn) __engine.gameCommand('end_turn', {}); return false; })()",
        "value": true
      },
      "timeout_frames": 1500,
      "check_every": 5
    },
    {
      "assert": {
        "combat": true,
        "path": "resources.movement",
        "value": 9,
        "message": "los recursos se resetean al empezar cada turno"
      }
    },

    {
      "log": "Punto 7: fin del combate (por comando hasta que exista el ataque) → victoria → exploración"
    },
    { "command": "end_combat", "args": { "result": "victory" } },
    { "assert": { "combat": true, "path": "state", "value": "victory" } },
    { "wait_seconds": 2.2 },
    { "assert": { "combat": true, "path": "state", "value": "exploration" } },
    { "wait_frames": 30 },
    {
      "assert": {
        "combat": true,
        "path": "state",
        "value": "exploration",
        "message": "los enemigos de ese combate no lo reinician"
      }
    },

    { "assert": { "no_errors": true } }
  ]
}
