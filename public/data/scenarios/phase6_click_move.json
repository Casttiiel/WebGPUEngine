{
  "description": "Fase 6: en exploración cada click de movimiento corta el anterior y la unidad (y la party detrás) va al último destino, sin esperar a llegar. En combate no: mientras se mueve no acepta otro destino.",
  "scenes": ["tactical.json", "tactical_dummies.json"],
  "seed": 1,
  "steps": [
    {
      "wait_until": { "status": true, "path": "navMeshBuilt", "value": true },
      "timeout_frames": 300
    },
    { "wait_frames": 5 },
    {
      "eval": "window.__feet = (n) => Array.from(Engine.getEntities().getEntityByName(n).getComponent('unit').getFeetPosition(new Float32Array(3))); window.__near = (n, p, tol) => { const f = __feet(n); return Math.hypot(f[0] - p[0], f[2] - p[2]) < tol; }"
    },

    { "log": "Click para ir a un sitio y, a mitad de camino, click en otro" },
    { "input": { "type": "click", "world": [-10, 0, 2] } },
    { "wait_frames": 20 },
    { "assert": { "entity": "Hero1", "path": "unit.isMoving", "value": true } },
    { "input": { "type": "click", "world": [-1, 0, -3] } },
    { "wait_frames": 3 },
    {
      "assert": {
        "expr": "__engine.gameCommand('plan_move', { unit: 'Hero1', to: [-10, 0, 2] }).then(r => r.allowed)",
        "value": true,
        "message": "andando sigue aceptando destinos"
      }
    },
    {
      "wait_until": { "entity": "Hero1", "path": "unit.isMoving", "value": false },
      "timeout_frames": 600
    },
    {
      "assert": {
        "expr": "__near('Hero1', [-1, 0, -3], 0.4)",
        "value": true,
        "message": "llega al último destino"
      }
    },

    { "log": "Varios clicks seguidos: cuenta el último" },
    { "input": { "type": "click", "world": [-6, 0, -1] } },
    { "wait_frames": 6 },
    { "input": { "type": "click", "world": [2, 0, -6] } },
    { "wait_frames": 6 },
    { "input": { "type": "click", "world": [-3, 0, 1] } },
    {
      "wait_until": {
        "expr": "['Hero1', 'Hero2', 'Hero3', 'Hero4'].every(n => !Engine.getEntities().getEntityByName(n).getComponent('unit').isMoving())",
        "value": true
      },
      "timeout_frames": 900
    },
    { "assert": { "expr": "__near('Hero1', [-3, 0, 1], 0.4)", "value": true } },
    {
      "assert": {
        "expr": "['Hero2', 'Hero3', 'Hero4'].every(n => Math.hypot(__feet(n)[0] - __feet('Hero1')[0], __feet(n)[2] - __feet('Hero1')[2]) < 3.5)",
        "value": true,
        "message": "la party también va al último destino"
      }
    },
    { "assert": { "combat": true, "path": "state", "value": "exploration" } },

    { "log": "En combate un movimiento en curso no se cambia" },
    { "command": "start_combat" },
    {
      "wait_until": {
        "expr": "(() => { const s = __engine.getCombatState(); return s.playerTurn && !s.busy; })()",
        "value": true
      },
      "timeout_frames": 900
    },
    {
      "eval": "window.__active = __engine.getCombatState().activeUnit; window.__start = __feet(window.__active)"
    },
    {
      "assert": {
        "expr": "__engine.gameCommand('move', { unit: window.__active, to: [window.__start[0] + 3, 0, window.__start[2]] }).then(r => r.ok)",
        "value": true
      }
    },
    { "wait_frames": 5 },
    {
      "assert": {
        "expr": "__engine.gameCommand('move', { unit: window.__active, to: [window.__start[0], 0, window.__start[2] + 2] }).then(r => [r.ok, r.reason])",
        "value": [false, "unit is busy"]
      }
    },
    { "assert": { "no_errors": true } }
  ]
}
