{
  "description": "Fase 6 (feedback): plano de acción. Al lanzar una habilidad o atacar, la cámara ActionCamera se coloca por encima del hombro del atacante encuadrándole a él y a su objetivo, y el ModuleCameraMixer la mezcla encima de la cámara de juego; al acabar se mezcla de vuelta. Mover la cámara lo corta.",
  "scenes": ["tactical.json", "tactical_dummies.json"],
  "seed": 7,
  "steps": [
    {
      "wait_until": { "status": true, "path": "navMeshBuilt", "value": true },
      "timeout_frames": 300
    },
    { "wait_frames": 5 },
    {
      "eval": "window.__ac = Engine.getEntities().getObjectManagerByName('action_camera').getList()[0]; window.__camDist = (name) => { const a = Engine.getRender().getMainCamera().getPosition(); const b = Engine.getEntities().getEntityByName(name).getComponent('camera').getCamera().getPosition(); return Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]); }"
    },
    { "assert": { "expr": "__ac.isInShot()", "value": false } },

    { "log": "Habilidad fuera de combate: Palabra curativa de Hero3 a Hero1 → plano de acción" },
    { "command": "damage", "args": { "unit": "Hero1", "amount": 10 } },
    { "command": "select", "args": { "unit": "Hero3" } },
    { "wait_frames": 60 },
    {
      "assert": {
        "expr": "__engine.gameCommand('skill', { unit: 'Hero3', skill: 'heal', target: 'Hero1' }).then(r => r.ok)",
        "value": true
      }
    },
    { "assert": { "expr": "__ac.isInShot()", "value": true } },
    { "wait_frames": 30 },
    {
      "assert": {
        "expr": "__camDist('ActionCamera') < 0.05",
        "value": true,
        "message": "terminada la mezcla de entrada se ve la cámara de acción"
      }
    },
    {
      "assert": {
        "entity": "ActionCamera",
        "path": "camera.getCamera.getPosition.1",
        "op": "<",
        "value": 6,
        "message": "plano bajo (la vista táctica está a ~11 m)"
      }
    },
    { "screenshot": "01-heal" },
    { "wait_until": { "expr": "__ac.isInShot()", "value": false }, "timeout_frames": 120 },
    { "wait_frames": 45 },
    {
      "assert": {
        "expr": "__camDist('PlayerCamera') < 0.05",
        "value": true,
        "message": "al acabar vuelve a la cámara de juego"
      }
    },

    { "assert": { "entity": "Hero1", "path": "health.getHp", "value": 30 } },

    { "log": "Mover la cámara corta el plano" },
    {
      "eval": "__ac.frameAction(Engine.getEntities().getEntityByName('Hero1'), [Engine.getEntities().getEntityByName('Hero2')], 5)"
    },
    { "wait_frames": 10 },
    { "assert": { "expr": "__ac.isInShot()", "value": true } },
    { "input": { "type": "key", "key": "KeyQ", "action": "down" } },
    { "wait_frames": 2 },
    { "input": { "type": "key", "key": "KeyQ", "action": "up" } },
    { "assert": { "expr": "__ac.isInShot()", "value": false } },
    { "wait_frames": 60 },
    { "assert": { "expr": "__camDist('PlayerCamera') < 0.05", "value": true } },

    { "log": "Ataque en combate: encuadra al atacante y al objetivo, y aguanta más si lo mata" },
    { "command": "select", "args": { "unit": "Hero1" } },
    { "command": "move", "args": { "unit": "Hero1", "to": [-2.5, 0, 13] } },
    { "wait_until": { "combat": true, "path": "state", "value": "combat" }, "timeout_frames": 600 },
    {
      "wait_until": {
        "expr": "(() => { const s = __engine.getCombatState(); return s.playerTurn && !s.busy && !Engine.getEntities().getEntityByName(s.activeUnit).getComponent('unit').isBusy(); })()",
        "value": true
      },
      "timeout_frames": 600
    },
    { "command": "damage", "args": { "unit": "Enemy1", "amount": 16 } },
    {
      "assert": {
        "expr": "__engine.gameCommand('attack', { unit: __engine.getCombatState().activeUnit, target: 'Enemy1', attack: 'ranged' }).then(r => r.ok)",
        "value": true
      }
    },
    { "assert": { "expr": "__ac.isInShot()", "value": true } },
    { "wait_frames": 35 },
    { "screenshot": "02-attack" },
    { "assert": { "entity": "Enemy1", "path": "health.getHp", "value": 0 } },
    { "wait_frames": 50 },
    {
      "assert": {
        "expr": "__ac.isInShot()",
        "value": true,
        "message": "la muerte alarga el plano (sin ella habría acabado a los 66 frames)"
      }
    },
    { "screenshot": "03-kill" },
    { "wait_until": { "expr": "__ac.isInShot()", "value": false }, "timeout_frames": 120 },
    { "wait_frames": 45 },
    { "assert": { "expr": "__camDist('PlayerCamera') < 0.05", "value": true } }
  ]
}
