            {
              "from": "Run",
              "to": "InAir",
              "condition": "isInAir",
              "blendTime": 0.15
            },
            {
              "from": "InAir",
              "to": "Idle",
              "conditionFalse": "isInAir",
              "blendTime": 0.2
