# Unit Frustum Mesh
# Generated from C++ createCameraFrustumSolid function
# 8 vertices, 12 triangles (6 faces)

# Vertices (position)
v -1.0 -1.0 0.0
v 1.0 -1.0 0.0
v -1.0 -1.0 1.0
v 1.0 -1.0 1.0
v -1.0 1.0 0.0
v 1.0 1.0 0.0
v -1.0 1.0 1.0
v 1.0 1.0 1.0

# Vertex normals (placeholder - will be computed if needed)
vn 0.0 0.0 1.0

# Texture coordinates (UV mapping for frustum faces)
vt 0.0 0.0  # 1: Bottom-left
vt 1.0 0.0  # 2: Bottom-right  
vt 0.0 1.0  # 3: Top-left
vt 1.0 1.0  # 4: Top-right
vt 0.5 0.0  # 5: Center-bottom
vt 0.5 1.0  # 6: Center-top
vt 0.0 0.5  # 7: Left-center
vt 1.0 0.5  # 8: Right-center

# Faces (triangles) with proper UV mapping
# Right face: addFace(5, 1, 3, 7) -> triangles (5,3,1) and (5,7,3)
f 6/1/1 4/2/1 2/3/1
f 6/1/1 8/4/1 4/2/1

# Bottom face: addFace(1, 0, 2, 3) -> triangles (1,2,0) and (1,3,2)  
f 2/3/1 3/4/1 1/1/1
f 2/3/1 4/2/1 3/4/1

# Left face: addFace(0, 4, 6, 2) -> triangles (0,6,4) and (0,2,6)
f 1/1/1 7/4/1 5/3/1
f 1/1/1 3/4/1 7/4/1

# Top face: addFace(4, 5, 7, 6) -> triangles (4,7,5) and (4,6,7)
f 5/3/1 8/4/1 6/1/1
f 5/3/1 7/4/1 8/4/1

# Near face: addFace(0, 1, 5, 4) -> triangles (0,5,1) and (0,4,5)
f 1/1/1 6/1/1 2/3/1
f 1/1/1 5/3/1 6/1/1

# Far face: addFace(7, 3, 2, 6) -> triangles (7,2,3) and (7,6,2)
f 8/4/1 3/4/1 4/2/1
f 8/4/1 7/4/1 3/4/1
