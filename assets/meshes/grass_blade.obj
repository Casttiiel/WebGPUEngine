# grass_blade.obj
# Two 1x1 quads crossing at 90° (X shape when viewed from above).
# Y = 0 at root (no wind), Y = 1 at tip (full wind).
# UV: U = 0..1 across width, V = 1 at root, V = 0 at tip.
# Normals: (0,1,0) so blades receive same top-down light as terrain.

o grass_blade

# Quad A — in the XY plane (Z = 0)
#   root-left     root-right    tip-left      tip-right
v -0.5  0.0  0.0
v  0.5  0.0  0.0
v -0.5  1.0  0.0
v  0.5  1.0  0.0

# Quad B — in the ZY plane (X = 0), rotated 90° around Y
#   root-front    root-back     tip-front     tip-back
v  0.0  0.0 -0.5
v  0.0  0.0  0.5
v  0.0  1.0 -0.5
v  0.0  1.0  0.5

# UVs: (0,1)=root-left  (1,1)=root-right  (0,0)=tip-left  (1,0)=tip-right
vt 0.0  1.0
vt 1.0  1.0
vt 0.0  0.0
vt 1.0  0.0

# Normal pointing up — blades receive terrain-like top-down lighting
vn  0.0  1.0  0.0

# Quad A triangles
f  1/1/1  2/2/1  3/3/1
f  2/2/1  4/4/1  3/3/1

# Quad B triangles
f  5/1/1  6/2/1  7/3/1
f  6/2/1  8/4/1  7/3/1

