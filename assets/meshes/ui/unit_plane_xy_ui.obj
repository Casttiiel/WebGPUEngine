# Unit Plane Mesh for UI Rendering
# WebGPU Engine - UI System
# Quad from (-0.5, -0.5) to (0.5, 0.5) in XY plane
# UVs: (0,0) bottom-left to (1,1) top-right (WebGPU convention)

# Vertices (XYZ)
v -0.5 -0.5 0.0
v  0.5 -0.5 0.0
v  0.5  0.5 0.0
v -0.5  0.5 0.0

# Texture coordinates (UV)
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0

# Normals (facing +Z)
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0

# Faces (v/vt/vn)
# Triangle 1: bottom-left, bottom-right, top-right
f 1/1/1 2/2/2 3/3/3
# Triangle 2: bottom-left, top-right, top-left
f 1/1/1 3/3/3 4/4/4
